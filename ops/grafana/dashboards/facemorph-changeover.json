   "id": 2,
   "type": "stat",
   "title": "Photos encoded: old API",
   "description": "Server-side encodes counted by the retired API.",
   "datasource": {
    "type": "prometheus",
    "uid": "FAM3SZFGk"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "FAM3SZFGk"
     },
     "refId": "A",
     "expr": "sum(increase(image_encoding_total[$__range]))",
     "instant": true
    }
   ]
  },
