{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceMorph Preview",
  "version": "0.1.0",
  "identifier": "me.facemorph.checkface",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "FaceMorph Preview", "width": 1100, "height": 800}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {"active": false, "createUpdaterArtifacts": false},
  "plugins": {"updater": {"pubkey": "", "endpoints": []}}
}
