{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/deploy-next/**",
    "**/test-results/**",
    "**/.cache/**",
    "**/package-lock.json",
    "**/*.md",
    ".beads/**",
    "apps/web/src/**",
    "apps/web/desktop/**",
    "apps/web/photo-runtime/**",
    "apps/web/scripts/**",
    "apps/web/experiment/**",
    "apps/web/hosting/**",
    "apps/web/tests/**",
    "apps/web/test/goldens/**",
    "apps/web/test/fixtures/**",
    "autoresearch/benchmark-campaign-v2/**",
    "autoresearch/candidates/**",
    "autoresearch/devices/**",
    "autoresearch/history/**",
    "autoresearch/reviews/**",
    "autoresearch/templates/**",
    "import/**",
    "inventory/**",
    "docs/**",
    "scripts/names-snapshot/manifest.tsv",
    "packages/model-conv/**"
  ]
}
