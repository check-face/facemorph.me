{
  "schema": "facemorph.dependency-policy/1",
  "activeNodeMajor": 24,
  "updater": "dependabot",
  "reason": "GitHub built-in updater opens native bot PRs without a new service credential. Required group gates decide merge; failed updates remain open.",
  "groups": {
    "build-tools": {
      "patterns": ["*"],
      "excludePatterns": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@mui/*",
        "@emotion/*",
        "bulma",
        "bulma-prefers-dark",
        "react-advanced-cropper",
        "onnxruntime-web",
        "playwright",
        "@playwright/*",
        "fast-check",
        "browser-harness"
      ],
      "requiredChecks": ["scaffold / gates", "build-identity / check", "identity-check / check"]
    },
    "react-and-ui": {
      "patterns": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "@mui/*",
        "@emotion/*",
        "bulma",
        "bulma-prefers-dark",
        "react-advanced-cropper"
      ],
      "requiredChecks": [
        "web-shell / check",
        "web-shell / e2e",
        "web-shell / facade (1)",
        "web-shell / facade (2)",
        "web-shell / facade (3)",
        "web-shell / facade (4)",
        "next-site / compiled-ui",
        "next-site / qualify / real-ui-cpu"
      ]
    },
    "onnx-runtime": {
      "patterns": ["onnxruntime-web"],
      "requiredChecks": [
        "ort-canaries / cpu",
        "ort-canaries / webgpu-ort",
        "mobile-browser / android",
        "mobile-browser / ios",
        "mobile-browser / ios-product-artifact",
        "mobile-browser / ios-product-simulator"
      ]
    },
    "test-tools": {
      "patterns": ["playwright", "@playwright/*", "fast-check", "browser-harness"],
      "requiredChecks": [
        "ci-shared / helpers",
        "ci-shared / lookup",
        "contracts-m1 / browsers",
        "next-matrix / ubuntu-24.04 chromium (Playwright Chromium, not Chrome on a phone)",
        "next-matrix / ubuntu-24.04 firefox (Playwright Firefox on Linux)",
        "next-matrix / ubuntu-24.04 webkit (WebKit on Linux, not iOS)",
        "next-matrix / macos-15 webkit (Playwright WebKit, not Safari)",
        "next-matrix / macos-15 firefox (Playwright Firefox on macOS)",
        "next-matrix / summary"
      ]
    }
  },
  "excludedPaths": ["classic/**", "self-host/**"],
  "toleranceFiles": {
    "packages/stylegan-js/src/contracts/numerics.ts": "20a87e09327976622088eabdcc44eb173cf4471f8dae8ed01de1049a5a82a09c"
  },
  "requiredJobs": {
    ".github/workflows/scaffold.yml": ["gates"],
    ".github/workflows/identity-check.yml": ["check"],
    ".github/workflows/web-shell.yml": ["e2e", "runtime-e2e", "facade", "crop-acceptance"],
    ".github/workflows/parity-harness.yml": ["served"],
    ".github/workflows/next-site.yml": ["artifact", "qualify"],
    ".github/workflows/next-site-artifact.yml": ["artifact"],
    ".github/workflows/next-site-qualify.yml": ["qualify", "compiled-ui"],
    ".github/workflows/contracts-m1.yml": ["browsers"],
    ".github/workflows/mobile-browser.yml": ["android", "ios-product-simulator"],
    ".github/workflows/hosted-lanes.yml": ["desktop", "android", "ios"],
    ".github/workflows/next-matrix.yml": ["engines", "summary"],
    ".github/workflows/main.yml": ["dependency-policy", "ort-canaries", "next-matrix"]
  },
  "requiredMatrices": {
    ".github/workflows/next-matrix.yml": {
      "engines": {
        "include": [
          {
            "os": "ubuntu-24.04",
            "engine": "chromium",
            "label": "Playwright Chromium, not Chrome on a phone"
          },
          {
            "os": "ubuntu-24.04",
            "engine": "firefox",
            "label": "Playwright Firefox on Linux"
          },
          {
            "os": "ubuntu-24.04",
            "engine": "webkit",
            "label": "WebKit on Linux, not iOS"
          },
          {
            "os": "macos-15",
            "engine": "webkit",
            "label": "Playwright WebKit, not Safari"
          },
          {
            "os": "macos-15",
            "engine": "firefox",
            "label": "Playwright Firefox on macOS"
          }
        ]
      }
    },
    ".github/workflows/main.yml": {
      "ort-canaries": {
        "route": ["cpu", "webgpu-ort"]
      }
    }
  },
  "planRevision": {
    "date": "2026-10-27",
    "decision": "split next-site artifact building from qualification"
  }
}
