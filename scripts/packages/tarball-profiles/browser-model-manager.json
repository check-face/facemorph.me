{
  "profile": "browser-model-manager",
  "kind": "package",
  "requireExportTargets": true,
  "exportsIgnoreConditions": ["source"],
  "repositoryPathAllow": [],
  "required": [
    {
      "name": "package.json",
      "anyOf": ["^package\\.json$"]
    },
    {
      "name": "emitted-js",
      "anyOf": ["\\.[cm]?js$"]
    },
    {
      "name": "declarations",
      "anyOf": ["\\.d\\.[cm]?ts$"]
    },
    {
      "name": "LICENSE",
      "anyOf": ["^LICENSE(?:[.-][\\w.-]+)?$"],
      "flags": "i"
    },
    {
      "name": "THIRD_PARTY_NOTICES",
      "anyOf": ["^THIRD_PARTY_NOTICES(?:\\.\\w+)?$"]
    },
    {
      "name": "PROVENANCE.json",
      "anyOf": ["^PROVENANCE\\.json$"]
    }
  ],
  "description": "Verified model download/cache manager. No engine or inference code, no FaceMorph catalogue or hostnames.",
  "provenanceScope": "all",
  "contentRules": [
    {
      "id": "engine-code",
      "files": "\\.(?:[cm]?js|d\\.[cm]?ts)$",
      "pattern": "onnxruntime|\\bInferenceSession\\b|\\bort\\.(?:env|InferenceSession)\\b",
      "detail": "engine/inference code in the manager"
    },
    {
      "id": "facemorph-catalogue",
      "files": "\\.(?:[cm]?js|d\\.[cm]?ts|json)$",
      "pattern": "facemorph[-_ ]?catalog(?:ue)?",
      "flags": "i",
      "detail": "FaceMorph model catalogue"
    }
  ],
  "pathRules": [
    {
      "id": "facemorph-catalogue-file",
      "pattern": "(?:^|/)facemorph[-_]?catalog(?:ue)?[^/]*$",
      "detail": "FaceMorph catalogue file"
    }
  ],
  "shared": {
    "weightExtensions": [
      ".onnx",
      ".ort",
      ".bin",
      ".pt",
      ".pth",
      ".pkl",
      ".safetensors",
      ".npy",
      ".npz",
      ".h5",
      ".tflite"
    ],
    "maxFileBytes": 5242880,
    "oversizeAllowlist": ["\\.wasm$"],
    "repositoryPaths": [
      "^apps/",
      "^autoresearch/",
      "^docs/receipts/",
      "^docs/plans/",
      "^\\.beads/",
      "^deploy-next/",
      "^experiment/",
      "(?:^|/)(?:__fixtures__|fixtures|__tests__|test|tests)/",
      "\\.(?:test|spec)\\.[cm]?[jt]s$"
    ],
    "codeFiles": "\\.(?:[cm]?js|d\\.[cm]?ts|json)$",
    "docFiles": "\\.(?:md|markdown|txt)$",
    "absolutePathPatterns": [
      {
        "id": "home-dir",
        "pattern": "(?<![A-Za-z0-9_.:-])/(?:home|Users|root)/"
      },
      {
        "id": "windows-user-dir",
        "pattern": "[A-Za-z]:\\\\+Users\\\\"
      },
      {
        "id": "sibling-classic",
        "pattern": "\\.\\./facemorph\\.me-classic"
      },
      {
        "id": "sibling-checkout",
        "pattern": "\\.\\./(?:checkface|facemorph[\\w.-]*|encoder4editing|fm-control|fm-direct)/"
      },
      {
        "id": "file-url",
        "pattern": "file://"
      }
    ],
    "secretPatterns": [
      {
        "rule": "secret-npm-token",
        "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"
      },
      {
        "rule": "secret-cloudflare-token",
        "pattern": "\\bcf(?:ut|at)_[A-Za-z0-9]{30,}|(?:CLOUDFLARE|CF)_API_(?:TOKEN|KEY)\\s*[=:]\\s*[\"']?[A-Za-z0-9_-]{37,}"
      },
      {
        "rule": "secret-private-key",
        "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
      },
      {
        "rule": "secret-aws-key",
        "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b|aws_secret_access_key\\s*[=:]\\s*[\"']?[A-Za-z0-9/+=]{40}"
      }
    ],
    "npmrcAuthPattern": "_authToken|_auth\\s*=|_password\\s*=",
    "productionHostnames": [
      "(?:[a-z0-9-]+\\.)*facemorph\\.me\\b",
      "[a-z0-9-]+\\.cdilga\\.workers\\.dev\\b",
      "\\bcheckface\\b"
    ],
    "r2BucketNames": ["facemorph-diagnostics"],
    "r2BucketPatterns": ["bucket[_\\s-]*(?:name)?[\"'\\s:=]+facemorph-[a-z0-9-]+"]
  }
}
