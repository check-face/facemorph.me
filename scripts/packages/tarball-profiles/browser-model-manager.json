{
  "profile": "browser-model-manager",
  "kind": "package",
  "requireExportTargets": true,
  "exportsIgnoreConditions": ["source"],
  "repositoryPathAllow": [],
  "required": [
    {
      "name": "package.json",
      "anyOf": ["^package\\.json$"]
    },
    {
      "name": "emitted-js",
      "anyOf": ["\\.[cm]?js$"]
    },
    {
      "name": "declarations",
      "anyOf": ["\\.d\\.[cm]?ts$"]
    },
    {
      "name": "LICENSE",
      "anyOf": ["^LICENSE(?:[.-][\\w.-]+)?$"],
      "flags": "i"
    },
    {
      "name": "THIRD_PARTY_NOTICES",
      "anyOf": ["^THIRD_PARTY_NOTICES(?:\\.\\w+)?$"]
    },
    {
      "name": "PROVENANCE.json",
      "anyOf": ["^PROVENANCE\\.json$"]
    }
  ],
  "description": "Verified model download/cache manager. No engine/inference code or FaceMorph catalogue; exact public documentation/defaults and persisted storage identities are classified below, never private hostnames or repository paths.",
  "provenanceScope": "all",
  "contentRules": [
    {
      "id": "engine-code",
      "files": "\\.(?:[cm]?js|d\\.[cm]?ts)$",
      "pattern": "onnxruntime|\\bInferenceSession\\b|\\bort\\.(?:env|InferenceSession)\\b",
      "detail": "engine/inference code in the manager"
    },
    {
      "id": "facemorph-catalogue",
      "files": "\\.(?:[cm]?js|d\\.[cm]?ts|json)$",
      "pattern": "facemorph[-_ ]?catalog(?:ue)?",
      "flags": "i",
      "detail": "FaceMorph model catalogue"
    }
  ],
  "pathRules": [
    {
      "id": "facemorph-catalogue-file",
      "pattern": "(?:^|/)facemorph[-_]?catalog(?:ue)?[^/]*$",
      "detail": "FaceMorph catalogue file"
    }
  ],
  "shared": {
    "weightExtensions": [
      ".onnx",
      ".ort",
      ".bin",
      ".pt",
      ".pth",
      ".pkl",
      ".safetensors",
      ".npy",
      ".npz",
      ".h5",
      ".tflite"
    ],
    "maxFileBytes": 5242880,
    "oversizeAllowlist": ["\\.wasm$"],
    "repositoryPaths": [
      "^apps/",
      "^autoresearch/",
      "^docs/receipts/",
      "^docs/plans/",
      "^\\.beads/",
      "^deploy-next/",
      "^experiment/",
      "(?:^|/)(?:__fixtures__|fixtures|__tests__|test|tests)/",
      "\\.(?:test|spec)\\.[cm]?[jt]s$"
    ],
    "codeFiles": "\\.(?:[cm]?js|d\\.[cm]?ts|json)$",
    "docFiles": "\\.(?:md|markdown|txt)$",
    "absolutePathPatterns": [
      {
        "id": "home-dir",
        "pattern": "(?<![A-Za-z0-9_.:-])/(?:home|Users|root)/"
      },
      {
        "id": "windows-user-dir",
        "pattern": "[A-Za-z]:\\\\+Users\\\\"
      },
      {
        "id": "sibling-classic",
        "pattern": "\\.\\./facemorph\\.me-classic"
      },
      {
        "id": "sibling-checkout",
        "pattern": "\\.\\./(?:checkface|facemorph[\\w.-]*|encoder4editing|fm-control|fm-direct)/"
      },
      {
        "id": "file-url",
        "pattern": "file://"
      }
    ],
    "secretPatterns": [
      {
        "rule": "secret-npm-token",
        "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"
      },
      {
        "rule": "secret-cloudflare-token",
        "pattern": "\\bcf(?:ut|at)_[A-Za-z0-9]{30,}|(?:CLOUDFLARE|CF)_API_(?:TOKEN|KEY)\\s*[=:]\\s*[\"']?[A-Za-z0-9_-]{37,}"
      },
      {
        "rule": "secret-private-key",
        "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY"
      },
      {
        "rule": "secret-aws-key",
        "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b|aws_secret_access_key\\s*[=:]\\s*[\"']?[A-Za-z0-9/+=]{40}"
      }
    ],
    "npmrcAuthPattern": "_authToken|_auth\\s*=|_password\\s*=",
    "productionHostnames": [
      "(?:[a-z0-9-]+\\.)*facemorph\\.me\\b",
      "[a-z0-9-]+\\.cdilga\\.workers\\.dev\\b",
      "\\bcheckface\\b"
    ],
    "r2BucketNames": ["facemorph-diagnostics"],
    "r2BucketPatterns": ["bucket[_\\s-]*(?:name)?[\"'\\s:=]+facemorph-[a-z0-9-]+"]
  },
  "provenanceAllow": [
    {
      "files": "^dist/(?:cache/model-cache\\.(?:js|d\\.ts)|contracts/lifecycle\\.js)$",
      "pattern": "([\"\\x27])checkface-model-blobs-v1\\1|\\(checkface-model-blobs-v1\\)",
      "reason": "MODEL_CACHE_NAME and lifecycle compatibility documentation: the existing on-device Cache Storage identity must survive package extraction without losing cached model bytes."
    },
    {
      "files": "^dist/cache/shard-store\\.(?:js|d\\.ts)$",
      "pattern": "([\"\\x27])checkface-model-shards-v1\\1",
      "reason": "SHARD_DIRECTORY: the existing OPFS directory identity must survive package extraction without orphaning verified model chunks."
    },
    {
      "files": "^dist/cache/model-cache\\.js$",
      "pattern": "([\"\\x27])X-CheckFace-SHA256\\1(?=:\\s*asset\\.sha256\\b)",
      "reason": "Existing verified Cache Storage response header: its exact SHA-256 metadata key is compatibility data, not a private service or repository reference."
    },
    {
      "files": "^dist/cache/model-cache\\.js$",
      "pattern": "\\(models\\.facemorph\\.me, R2: separate storage\\)",
      "reason": "Public mirror example in the retry-policy comment, not a private service or a hardcoded acquisition request."
    },
    {
      "files": "^dist/cache/model-cache\\.js$",
      "pattern": "([\\\"\\x27])https://next\\.facemorph\\.me\\1",
      "reason": "Public fallback origin for cache keys outside a Window; construction/status performs no request to this origin."
    },
    {
      "files": "^dist/contracts/manifest\\.js$",
      "pattern": "(?<=candidate runtime manifest, )next\\.facemorph\\.me /runtime/manifest\\.json, SHA-256",
      "reason": "Public candidate-runtime shape documentation in the manifest contract; no private deployment path or model catalogue."
    },
    {
      "files": "^schema/model-manifest\\.v1\\.schema\\.json$",
      "pattern": "\"\\$id\":\\s*\"https://github\\.com/facemorph-me/facemorph\\.me/blob/main/packages/browser-model-manager/schema/model-manifest\\.v1\\.schema\\.json\"",
      "reason": "Public producer-contract schema $id, identifying this exact published schema in the public repository."
    },
    {
      "files": "^package\\.json$",
      "pattern": "github\\.com/facemorph-me/facemorph\\.me",
      "reason": "repository, homepage and bugs name the public source repository (with its packages/ directory) so npmjs.com resolves the README's relative links; a source reference, not a deployment hostname (fm-19eb)."
    },
    {
      "files": "^PROVENANCE\\.json$",
      "pattern": "\"repository\":\\s*\"facemorph-me/facemorph\\.me\"",
      "reason": "build.repository names the public source repository whose CI run built the tarball (GITHUB_REPOSITORY, write-provenance.mjs); a source reference, not a deployment hostname (fm-oagi)."
    }
  ]
}
