{
  "name": "browser-model-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Consented acquisition, verification, storage and eviction of browser model assets. Contracts so far (fm-hwh): lifecycle, leases, grants, budgets and the model manifest schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facemorph-me/facemorph.me.git",
    "directory": "packages/browser-model-manager"
  },
  "homepage": "https://github.com/facemorph-me/facemorph.me/tree/main/packages/browser-model-manager#readme",
  "bugs": {
    "url": "https://github.com/facemorph-me/facemorph.me/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "PROVENANCE.json",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "stylegan-js": "^0.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/packages/write-provenance.mjs",
    "test": "node test/run.mjs test/*.test.ts"
  },
  "devDependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
