{
  "name": "@facemorph/browser-model-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Consented acquisition, verification, storage and eviction of browser model assets. Contracts so far (fm-hwh): lifecycle, leases, grants, budgets and the model manifest schema.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "dependencies": {
    "@facemorph/stylegan-js": "^0.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
