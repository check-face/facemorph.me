{
  "name": "cloudflare-model-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stages, verifies and publishes verified model bytes for Cloudflare static hosting: chunking above the 25 MiB file limit, manifest rewriting against the manager's contract, reconstruction verification, dry-run-first publication with paid-service and model-terms refusals (fm-3osh).",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "facemorph-model-host": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "PROVENANCE.json",
    "cloudflare.config.ts",
    "vite.config.ts",
    "src/mirror/worker.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/packages/write-provenance.mjs",
    "test": "node --test test/*.test.ts",
    "test:workerd": "node --test test/*.workerd.ts",
    "test:staging": "node --test test/*.e2e.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "browser-model-manager": "^0.0.0",
    "cf": "^1.0.0-beta.21",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2"
  }
}
