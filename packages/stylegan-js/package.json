{
  "name": "@facemorph/stylegan-js",
  "version": "0.0.0",
  "private": true,
  "description": "StyleGAN mapping, synthesis and e4e encoding in the browser: engine contracts, and the engine core (./engine).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "source": "./src/engine/index.ts",
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts test/engine/*.test.ts test/full31/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
