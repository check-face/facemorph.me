{
  "name": "stylegan-js",
  "version": "0.0.0",
  "private": true,
  "description": "StyleGAN mapping, synthesis and e4e encoding in the browser: engine contracts, and the engine core (./engine).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facemorph-me/facemorph.me.git",
    "directory": "packages/stylegan-js"
  },
  "homepage": "https://github.com/facemorph-me/facemorph.me/tree/main/packages/stylegan-js#readme",
  "bugs": {
    "url": "https://github.com/facemorph-me/facemorph.me/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "source": "./src/engine/index.ts",
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./engine/webgpu": {
      "source": "./src/engine/webgpu.ts",
      "types": "./dist/engine/webgpu.d.ts",
      "default": "./dist/engine/webgpu.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts test/engine/*.test.ts test/full31/*.test.ts test/morph/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/packages/write-provenance.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "PROVENANCE.json"
  ]
}
